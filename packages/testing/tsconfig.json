{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Never compiled or published: vitest runs the TypeScript directly. ESM + bundler
    // resolution is what allows the top-level `await` the Docker-gated test files use.
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "rootDir": "src"
  },
  "include": ["src/**/*"]
}
