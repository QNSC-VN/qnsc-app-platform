# The first-party packages come from GitHub Packages, exactly as a product installs them.
@quynhonsemiconductor:registry=https://npm.pkg.github.com
# NO token here: pnpm 11 ignores `${NODE_AUTH_TOKEN}` in a project .npmrc on purpose (the file is
# committed). Supply it from a user-level config instead, which is what actions/setup-node writes in CI:
#   printf '//npm.pkg.github.com/:_authToken=%s\n' "$TOKEN" > "$RUNNER_TEMP/npmrc"
#   NPM_CONFIG_USERCONFIG="$RUNNER_TEMP/npmrc" pnpm install
# The token needs read:packages.
